graph TD
    Module["Module"]

    ModPath["ModPath<br/>owner, name"]
    DBFn["db(key, pattern, args)<br/>typed dynamic access"]

    TaxonomyStore["taxonomy<br/>Stored<Taxonomy>"]
    DocumentsStore["documents<br/>Stored<Document Collection>"]
    ExtractionStore["extraction<br/>Stored<Extraction>"]
    FunctionsStore["functions<br/>Stored<Function Library>"]
    PromptStore["prompt<br/>Stored<Prompt>"]
    AgentsStore["agents<br/>Stored<Agent Registry>"]

    FunctionDef["FunctionDef<br/>each FunctionDef is a tool"]
    Agent["Agent<br/>stored runtime state<br/>id, tools, msgs_ctr"]
    Message["Message"]
    JSONSchema["JSONSchema"]
    JsonData["JsonData"]
    Pattern["Pattern"]

    UserActor["USER<br/>human actor"]
    Coordinator["Coordinator<br/>delegates and summarizes"]
    TaxonomyExpert["TaxonomyExpert<br/>taxonomy specialist"]
    ExtractionExpert["ExtractionExpert<br/>extraction specialist"]

    LaunchFns["Launch FunctionDefs<br/>TaxonomyExpert()<br/>ExtractionExpert()"]
    MessageFn["messageAgent()"]

    Capability["Capability"]
    CapDocs["documents"]
    CapExt["extraction"]
    CapFns["functions"]
    CapTax["taxonomy"]
    CapPrompt["prompt"]
    CapAgents["agents"]

    Module -->|"path"| ModPath
    Module -->|"dynamic access"| DBFn
    Module --> TaxonomyStore
    Module --> DocumentsStore
    Module --> ExtractionStore
    Module --> FunctionsStore
    Module --> PromptStore
    Module --> AgentsStore

    FunctionsStore -->|"stores named"| FunctionDef
    AgentsStore -->|"stores"| Agent

    Agent -->|"tools field selects subset of"| FunctionDef
    FunctionDef -->|"selected entries become tools for"| Agent
    Agent -->|"conversation state"| Message

    FunctionDef -->|"tool input schema"| JSONSchema
    FunctionDef -->|"reads/writes values shaped as"| JsonData

    FunctionDef -->|"declares read access via"| Capability
    FunctionDef -->|"declares write access via"| Capability

    DBFn -->|"validated by"| Pattern
    DBFn -->|"returns values shaped as"| JsonData

    Capability --> CapDocs
    Capability --> CapExt
    Capability --> CapFns
    Capability --> CapTax
    Capability --> CapPrompt
    Capability --> CapAgents

    CapDocs -. "permits access to" .-> DocumentsStore
    CapExt -. "permits access to" .-> ExtractionStore
    CapFns -. "permits access to" .-> FunctionsStore
    CapTax -. "permits access to" .-> TaxonomyStore
    CapPrompt -. "permits access to" .-> PromptStore
    CapAgents -. "permits access to" .-> AgentsStore

    UserActor --> Coordinator
    Coordinator -->|"is represented at runtime by"| Agent
    TaxonomyExpert -->|"is represented at runtime by"| Agent
    ExtractionExpert -->|"is represented at runtime by"| Agent

    Coordinator -->|"uses launch tools"| LaunchFns
    Coordinator -->|"uses"| MessageFn

    LaunchFns -->|"spawns"| TaxonomyExpert
    LaunchFns -->|"spawns"| ExtractionExpert
    MessageFn -->|"messages"| TaxonomyExpert
    MessageFn -->|"messages"| ExtractionExpert

    TaxonomyExpert -->|"uses<br/>viewTaxonomy, addCategory, removeCategory, addSubcategory, removeSubCategory, listDocuments, viewDocument"| FunctionDef
    ExtractionExpert -->|"uses<br/>viewTaxonomy, listDocuments, viewDocument, addExtraction, viewExtractions"| FunctionDef
